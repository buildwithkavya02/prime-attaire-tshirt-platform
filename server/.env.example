# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/prime-attaire

# Secret used to sign admin JWTs — use a long random string in production
JWT_SECRET=

# How long an admin JWT stays valid
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173

# Port the API server listens on
PORT=5000

# Used only by scripts/seedAdmin.js to create the first admin account
ADMIN_NAME=Prime Attaire Admin
ADMIN_EMAIL=admin@primeattaire.com
ADMIN_PASSWORD=changeme123
